model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder","Assignment","Class","Date","Exam","School","Student","Subject","Teacher","Term","Submissions","Attendance","Incidents","Enrollments","Exam Results","Interventions","LMS Activity","Wellbeing Survey"]

ref table Assignment
ref table Class
ref table Date
ref table Exam
ref table School
ref table Student
ref table Subject
ref table Teacher
ref table Term
ref table Submissions
ref table Attendance
ref table Incidents
ref table Enrollments
ref table 'Exam Results'
ref table Interventions
ref table 'LMS Activity'
ref table 'Wellbeing Survey'
ref table Metrics

ref cultureInfo en-US

