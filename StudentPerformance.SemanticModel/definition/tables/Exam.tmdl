	partition Exam = m
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_exam.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"exam_key", Int64.Type}, {"subject_key", Int64.Type}, {"term_key", Int64.Type}, {"exam_type", type text}, {"exam_date_key", Int64.Type}, {"difficulty", type text}, {"max_score", Int64.Type}, {"pass_mark", Int64.Type}, {"question_count", Int64.Type}, {"duration_min", Int64.Type}, {"weight_in_term", type number}}, "en-US"),
				    Ord1 = Table.AddColumn(Typed, "difficulty Order", each List.PositionOf({"Easy", "Medium", "Hard"}, [difficulty]) + 1, Int64.Type),
				    Ord2 = Table.AddColumn(Ord1, "exam_type Order", each List.PositionOf({"Midterm", "Final"}, [exam_type]) + 1, Int64.Type)
				in
				    Ord2

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

