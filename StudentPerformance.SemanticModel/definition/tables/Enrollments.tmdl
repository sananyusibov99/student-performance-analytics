	column 'Prior Subject Score' = CALCULATE ( AVERAGE ( 'Exam Results'[score] ), REMOVEFILTERS ( 'Term' ), 'Exam'[exam_type] = "Final", 'Exam'[term_key] = MIN ( 'Term'[term_key] ) )
		dataType: double
		lineageTag: c08f7a3e-e836-4a4a-bf69-fe3078caaf64

	column 'Course Growth' = IF ( NOT ISBLANK ( 'Enrollments'[final_score] ) && NOT ISBLANK ( 'Enrollments'[Prior Subject Score] ), 'Enrollments'[final_score] - 'Enrollments'[Prior Subject Score] )
		dataType: double
		lineageTag: 2131bfe5-291f-4f9a-bf4c-ee05852ee956

	partition Enrollments = m
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_enrollment.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"enrollment_key", Int64.Type}, {"student_key", Int64.Type}, {"class_key", Int64.Type}, {"term_key", Int64.Type}, {"enroll_date_key", Int64.Type}, {"status", type text}, {"withdraw_date_key", Int64.Type}, {"final_score", type number}, {"final_grade", type text}, {"grade_points", type number}, {"credits_attempted", Int64.Type}, {"credits_earned", Int64.Type}}, "en-US")
				in
				    Typed

