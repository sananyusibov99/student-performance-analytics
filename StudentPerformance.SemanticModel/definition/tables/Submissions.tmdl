	partition Submissions = m
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_assignment_submission.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"submission_key", Int64.Type}, {"assignment_key", Int64.Type}, {"student_key", Int64.Type}, {"submitted_date_key", Int64.Type}, {"status", type text}, {"days_late", Int64.Type}, {"points_earned", type number}, {"max_points", Int64.Type}}, "en-US"),
				    Ord1 = Table.AddColumn(Typed, "status Order", each List.PositionOf({"On time", "Late", "Missing"}, [status]) + 1, Int64.Type)
				in
				    Ord1

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

