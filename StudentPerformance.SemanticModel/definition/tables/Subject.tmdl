table Subject
	lineageTag: 89e4ed73-4014-468f-ab9c-7df6996cd714

	column subject_key
		dataType: int64
		isHidden
		isKey
		lineageTag: 9ce470da-8eb5-408a-9e25-07160ff78dfb
