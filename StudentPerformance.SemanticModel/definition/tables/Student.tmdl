		sourceColumn: parent_education Order

	column 'Prior Final Score' = CALCULATE ( AVERAGE ( 'Exam Results'[score] ), 'Exam'[exam_type] = "Final", 'Exam'[term_key] = MIN ( 'Term'[term_key] ), REMOVEFILTERS ( 'Term' ) )
		dataType: double
		lineageTag: f5d88229-565e-4881-9146-15f2ccdc693c

	column 'Prior Score Band' = SWITCH ( TRUE (), ISBLANK ( 'Student'[Prior Final Score] ), BLANK (), 'Student'[Prior Final Score] < 50, "< 50", 'Student'[Prior Final Score] < 60, "50-59", 'Student'[Prior Final Score] < 70, "60-69", 'Student'[Prior Final Score] < 80, "70-79", 'Student'[Prior Final Score] < 90, "80-89", "90+" )
		dataType: string
		displayFolder: Bands
		lineageTag: 82d5d92f-3063-4315-b54c-33db4d1220b9
		sortByColumn: 'Prior Score Band Order'

	column 'Prior Score Band Order' = SWITCH ( TRUE (), ISBLANK ( 'Student'[Prior Final Score] ), BLANK (), 'Student'[Prior Final Score] < 50, 1, 'Student'[Prior Final Score] < 60, 2, 'Student'[Prior Final Score] < 70, 3, 'Student'[Prior Final Score] < 80, 4, 'Student'[Prior Final Score] < 90, 5, 6 )
		dataType: int64
		isHidden
		displayFolder: Bands
		lineageTag: 746fe99a-b3f5-4e2c-9c14-d338954d8bc6

	partition Student = m
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_student.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"student_key", Int64.Type}, {"student_id", type text}, {"school_key", Int64.Type}, {"gender", type text}, {"birth_date", type date}, {"education_level", type text}, {"grade_level", type text}, {"cohort_year", Int64.Type}, {"enrollment_date", type date}, {"family_income", type text}, {"parent_education", type text}, {"internet_access", Int64.Type}, {"device_availability", type text}, {"scholarship_flag", Int64.Type}, {"special_needs_flag", Int64.Type}, {"commute_km", type number}, {"entry_gpa", type number}}, "en-US"),
				    Ord1 = Table.AddColumn(Typed, "family_income Order", each List.PositionOf({"Low", "Lower-Middle", "Middle", "Upper-Middle", "High"}, [family_income]) + 1, Int64.Type),
				    Ord2 = Table.AddColumn(Ord1, "parent_education Order", each List.PositionOf({"High School", "Associate", "Bachelor", "Master", "Doctorate", "Not specified"}, [parent_education]) + 1, Int64.Type)
				in
				    Ord2

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

