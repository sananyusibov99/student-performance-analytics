	partition 'Wellbeing Survey' = m
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_wellbeing_survey.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"survey_key", Int64.Type}, {"student_key", Int64.Type}, {"term_key", Int64.Type}, {"survey_date_key", Int64.Type}, {"study_hours_per_day", type number}, {"self_study_hours", type number}, {"sleep_hours", type number}, {"daily_screen_time", type number}, {"physical_activity_hours", type number}, {"stress_level", Int64.Type}, {"practice_tests_completed", Int64.Type}, {"sleep_quality", type text}, {"class_participation", type text}, {"study_consistency", type text}, {"study_environment", type text}, {"study_method", type text}, {"revision_frequency", type text}, {"notes_quality", type text}, {"break_frequency", type text}, {"motivation_level", type text}, {"educational_app_usage", type text}}, "en-US"),
				    Ord1 = Table.AddColumn(Typed, "motivation_level Order", each List.PositionOf({"Low", "Medium", "High"}, [motivation_level]) + 1, Int64.Type),
				    Ord2 = Table.AddColumn(Ord1, "study_consistency Order", each List.PositionOf({"Low", "Medium", "High"}, [study_consistency]) + 1, Int64.Type),
				    Ord3 = Table.AddColumn(Ord2, "class_participation Order", each List.PositionOf({"Low", "Medium", "High"}, [class_participation]) + 1, Int64.Type),
				    Ord4 = Table.AddColumn(Ord3, "educational_app_usage Order", each List.PositionOf({"Low", "Moderate", "High"}, [educational_app_usage]) + 1, Int64.Type),
				    Ord5 = Table.AddColumn(Ord4, "sleep_quality Order", each List.PositionOf({"Poor", "Fair", "Good", "Excellent", "Not specified"}, [sleep_quality]) + 1, Int64.Type),
				    Ord6 = Table.AddColumn(Ord5, "revision_frequency Order", each List.PositionOf({"Rarely", "Weekly", "Daily"}, [revision_frequency]) + 1, Int64.Type)
				in
				    Ord6

	annotation PBI_ResultType = Table

